# Copy to .env and fill in. NEVER commit .env.

# --- Core ---
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://gtm:gtm@localhost:5432/gtm
CORS_ORIGINS=http://localhost:3000

# --- Provider selection (mock = no network, no cost) ---
ENABLED_CONNECTORS=mock_opportunities,mock_agencies

# --- Spending limits (USD). Providers are blocked once a limit is reached. ---
SPEND_LIMIT_PER_RUN_USD=1.00
SPEND_LIMIT_DAILY_USD=5.00
SPEND_LIMIT_MONTHLY_USD=50.00

# --- OpenAI (unused in Milestone 1; agents use deterministic logic) ---
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Apify (unused in Milestone 1; no Actors are executed) ---
APIFY_TOKEN=

# --- Worker ---
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_MAX_ATTEMPTS=3

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
