# Copy to .env and fill in. NEVER commit .env.

# --- Core ---
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://gtm:gtm@localhost:5432/gtm
CORS_ORIGINS=http://localhost:3000

# --- Provider selection (mock = no network, no cost) ---
# Real (paid) connectors available once approved: apify_ted_tenders, apify_worldbank_tenders
ENABLED_CONNECTORS=mock_opportunities,mock_agencies

# --- Spending limits (USD). Providers are blocked once a limit is reached. ---
SPEND_LIMIT_PER_RUN_USD=1.00
SPEND_LIMIT_DAILY_USD=5.00
SPEND_LIMIT_MONTHLY_USD=50.00

# --- LLM: OpenAI is the default provider ---
# Mock mode is offline and free. A live call needs ALL of: LLM_MOCK_MODE=false,
# LLM_PAID_CALLS_ENABLED=true, OPENAI_API_KEY, OPENAI_MODEL, and both price values below.
LLM_PROVIDER=openai
LLM_MOCK_MODE=true
LLM_PAID_CALLS_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
OPENAI_DISCOVERY_MODEL=gpt-5.4-mini
OPENAI_RESEARCH_MODEL=gpt-5.4-mini
OPENAI_QUALIFICATION_MODEL=gpt-5.4-mini
OPENAI_OUTREACH_MODEL=gpt-5.4-mini
OPENAI_ANALYTICS_MODEL=gpt-5.4-mini
# USD per 1M tokens, copied by you from OpenAI's pricing page for the model you chose.
# Left blank on purpose: no prices are assumed, and live calls are refused without them.
# Standard API prices per 1M tokens, read from developers.openai.com/api/docs/models/gpt-5.4-mini
# on 2026-11-03. Re-check before each live test; pricing can change.
OPENAI_INPUT_USD_PER_MTOK=0.75
OPENAI_CACHED_INPUT_USD_PER_MTOK=0.075
OPENAI_OUTPUT_USD_PER_MTOK=4.50
LLM_MAX_OUTPUT_TOKENS=1500
LLM_MAX_RETRIES=3
LLM_SPEND_LIMIT_PER_RUN_USD=0.50
AI_MAX_OPPORTUNITIES_PER_RUN=10

# --- Apify (nothing paid runs unless token is set AND approval flag is true) ---
APIFY_TOKEN=
APIFY_PAID_EXECUTION_APPROVED=false

# --- Source verification (fetches the cited page, respects robots.txt) ---
SOURCE_VERIFICATION_ENABLED=false

# --- Worker ---
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_MAX_ATTEMPTS=3

# --- Docker host ports (change if 5432/3000 are already used) ---
DB_PORT=5432

# --- Frontend ---
# Host port for the dashboard container (change if 3000 is taken).
FRONTEND_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# Controlled live test: lifetime caps enforced before every provider call (upper limits, not targets)
OPENAI_TEST_BUDGET_USD=0.50
APIFY_TEST_BUDGET_USD=0.25
TOTAL_TEST_BUDGET_USD=0.75
RUN_TIMEOUT_SECONDS=900

# Milestone 3: qualification and agency discovery (all free, permitted public sources)
SMALL_TEAM_MAX_VALUE=750000
AI_RECORD_BUDGET_USD=0.05
AI_MAX_CALLS_PER_RECORD=3
AI_TASK_BUDGET_USD=0.25
AI_MAX_REPAIR_ATTEMPTS=1
AI_TASK_MAX_OUTPUT_TOKENS=dossier=2500,outreach_draft=900
# Companies/pages YOU choose to read (comma separated). Enable with ENABLED_CONNECTORS.
# Bare domains read only /partners, /partner-program, /become-a-partner, /white-label, /partnerships.
AGENCY_SEED_URLS=
AGENCY_FEED_URLS=
AGENCY_PAGES_MAX=20
